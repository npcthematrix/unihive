# UniHive 网关 - 环境变量配置样例
# 复制为 .env 并填入实际值；.env 已被 .gitignore 排除

# 同花顺金融数据 API Key (用于 rhths_ashare / rhths_index / rhths_meta / rhths_fund 四个上游)
RHTHS_API_KEY=

# Tushare Pro API Token (用于 tushare 上游)
TUSHARE_TOKEN=

# Gateway Bearer Token (HTTP mode only; STDIO mode ignores this)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 设置后未带正确 Authorization 头的请求会被中间件 401 拒绝
GATEWAY_BEARER_TOKEN=replace-with-a-long-random-string
