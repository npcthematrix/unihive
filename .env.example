# UniHive 网关 - 环境变量配置样例
# 复制为 .env 并填入实际值；.env 已被 .gitignore 排除

# 同花顺金融数据 API Key (用于 fuyao_ashare / fuyao_index / fuyao_meta / fuyao_fund 四个上游)
RHTHS_API_KEY=

# Console 管理 UI 登录（三个全设启用登录保护；任意一个留空则保持 console 开放，留向后兼容）
UNIHIVE_CONSOLE_USER=
UNIHIVE_CONSOLE_PASSWORD=
# 32+ 字符随机串；用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
UNIHIVE_CONSOLE_SESSION_SECRET=