# UniHive 网关 - 环境变量配置样例
# 复制为 .env 并填入实际值；.env 已被 .gitignore 排除

# 工作线程数（按上游拆分独立池, fuyao/omni 异步无需池）
# mootdx2 同步上游调用 (Reader 闸门上限 6, worker 默认 16 留 probe/close + 批量调度余量)
# UNIHIVE_MOOTDX2_WORKER_THREADS=16
# tdx_quant 量化终端调用 (get 并发, init/close 经 _dll_lock 串行, 默认 10)
# UNIHIVE_TDX_QUANT_WORKER_THREADS=10

# 同花顺金融数据 API Key (用于 fuyao_ashare / fuyao_index / fuyao_meta / fuyao_fund 四个上游)
FUYAO_API_KEY=

# Console 管理 UI 登录:
#   三个全设 = 启用登录保护; 三个全不设 = 关闭 (console 开放, 仅适合本机单用户);
#   只设一两个 = fail-closed 拒启, 不会静默裸奔。
UNIHIVE_CONSOLE_USER=
UNIHIVE_CONSOLE_PASSWORD=
# 32+ 字符随机串；用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成
UNIHIVE_CONSOLE_SESSION_SECRET=

# THSDK（社区 thsdk 包）同花顺账号凭证
# 两只同时留空 = 游客/临时会话登录；只设一只会启动失败。凭证不写入 YAML。
THS_USERNAME=
THS_PASSWORD=
# 自选股写工具总开关，默认关闭：仅 true/1/yes/on（不区分大小写）时
# 10 个 thsdk_*watchlist* 写工具才会被注册；进程启动后无运行时后门。
ALLOW_WATCHLIST_WRITE=false