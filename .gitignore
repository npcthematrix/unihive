# Secrets & local config
.env
config/upstreams.local.yaml
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Node (web/ 另有自己的 .gitignore; 根目录误生成的 node_modules 也要挡住)
node_modules/

# THSDK 登录会话文件（thsdk 包写入进程工作目录，内含账号会话，禁止提交）
account.session
*.session

# curl/libcurl cookie jar（手动抓包脚本产物，可能含会话凭据）
cookies.txt

# Logs & runtime data — 目录整体默认忽略 (调试抓包 .sse/.out/.hdr/*.py 等产物
# 一律不入库), 仅白名单放行明确需要跟踪的文件
logs/*
!logs/proxy-tab-verified.png
data/

# Session / planning artifacts (not part of the product)
.remember/
.remember/**
.playwright-mcp/
.playwright-mcp/**
docs/superpowers/
# AI 会话记忆与本地评审笔记 (本地产物, 不入库; 评审结论另见 docs/handoffs/)
.workbuddy-ai/
.workbuddy-ai/**
.claude/PRPs/
.claude/PRPs/**

# One-off debug / scratch
%TEMP%*
*.tmp
*.bak

# Old handoff (kept locally, archived elsewhere)
.handoff/
# Local verification / test artifacts
.verify-screenshots/
web/coverage/
